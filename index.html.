<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CampusTrack | Student Management</title>
<style>
:root{--navy:#172554;--blue:#3156c8;--bg:#f4f6fb;--ink:#182230;--muted:#6b7280;--line:#e7eaf1;--white:#fff;--green:#16845b;--red:#c24141}
*{box-sizing:border-box}body{margin:0;background:var(--bg);font-family:Arial,Helvetica,sans-serif;color:var(--ink)}
header{background:linear-gradient(120deg,#172554,#3156c8);color:white;padding:24px clamp(18px,4vw,52px)}
.top{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap}.brand{font-size:24px;font-weight:800;letter-spacing:.2px}.brand span{color:#b9c8ff}.sub{margin-top:6px;color:#dce4ff;font-size:14px}
main{max-width:1180px;margin:26px auto;padding:0 18px}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:20px}.stat,.panel{background:white;border:1px solid var(--line);border-radius:15px;box-shadow:0 5px 18px #1725540a}.stat{padding:18px 20px}.stat small{color:var(--muted);font-weight:600}.stat strong{display:block;font-size:29px;margin-top:8px;color:var(--navy)}
.panel{padding:20px}.panelhead{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:16px}.panel h2{font-size:18px;margin:0}.tools{display:flex;gap:9px;flex-wrap:wrap}
input,select{font:inherit;border:1px solid #d9deea;border-radius:9px;padding:10px 12px;background:white;min-width:0}input:focus,select:focus{outline:2px solid #c7d2fe;border-color:var(--blue)}
button{border:0;border-radius:9px;padding:10px 14px;font-weight:700;cursor:pointer;font-size:14px}.primary{background:var(--blue);color:white}.secondary{background:#eef2ff;color:#263e9a}.danger{background:#fff0f0;color:var(--red)}button:hover{filter:brightness(.96)}
.tablewrap{overflow-x:auto}table{width:100%;border-collapse:collapse;min-width:650px}th,td{text-align:left;padding:13px 11px;border-bottom:1px solid var(--line);font-size:14px}th{font-size:12px;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);background:#fafbfe}tbody tr:hover{background:#fafbff}.pill{display:inline-block;border-radius:30px;padding:5px 9px;font-size:12px;font-weight:700;background:#e8f7f0;color:var(--green)}.empty{text-align:center;padding:32px;color:var(--muted)}
.actions{display:flex;gap:6px}.actions button{padding:7px 9px;font-size:12px}
.modalback{position:fixed;inset:0;background:#10182880;display:none;align-items:center;justify-content:center;padding:16px;z-index:5}.modalback.show{display:flex}.modal{background:white;border-radius:16px;padding:22px;width:min(480px,100%);box-shadow:0 20px 60px #0003}.modal h2{margin:0 0 18px}.formgrid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.field{display:flex;flex-direction:column;gap:6px}.field label{font-size:13px;color:#4b5563;font-weight:700}.field input,.field select{width:100%}.full{grid-column:1/-1}.modalfoot{display:flex;justify-content:flex-end;gap:8px;margin-top:20px}.notice{color:var(--muted);font-size:12px;margin-top:15px}
@media(max-width:650px){.stats{grid-template-columns:1fr}.formgrid{grid-template-columns:1fr}.full{grid-column:auto}.panel{padding:15px}.brand{font-size:21px}}
</style>
</head>
<body>
<header><div class="top"><div><div class="brand">Campus<span>Track</span></div><div class="sub">Simple student management dashboard</div></div><div style="font-size:13px;color:#e0e7ff">WEB APPLICATION · PROJECT 2</div></div></header>
<main>
<section class="stats">
 <div class="stat"><small>Total Students</small><strong id="totalCount">0</strong></div>
 <div class="stat"><small>Active Students</small><strong id="activeCount">0</strong></div>
 <div class="stat"><small>Departments</small><strong id="deptCount">0</strong></div>
</section>
<section class="panel">
 <div class="panelhead"><h2>Student Directory</h2><div class="tools">
  <input id="search" type="search" placeholder="Search students..." aria-label="Search students">
  <button class="secondary" id="exportBtn">Export CSV</button><button class="primary" id="addBtn">+ Add Student</button>
 </div></div>
 <div class="tablewrap"><table><thead><tr><th>Student ID</th><th>Name</th><th>Email</th><th>Department</th><th>Status</th><th>Actions</th></tr></thead><tbody id="studentRows"></tbody></table></div>
 <div class="notice">Your records are saved in this browser using local storage. Use Export CSV to download a copy.</div>
</section>
</main>
<div class="modalback" id="modalBack" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
 <form class="modal" id="studentForm"><h2 id="modalTitle">Add Student</h2>
  <div class="formgrid">
   <div class="field"><label for="sid">Student ID</label><input id="sid" required maxlength="20" placeholder="e.g. BSCS-001"></div>
   <div class="field"><label for="name">Full Name</label><input id="name" required maxlength="60" placeholder="Student name"></div>
   <div class="field full"><label for="email">Email Address</label><input id="email" type="email" required placeholder="student@example.com"></div>
   <div class="field"><label for="department">Department</label><select id="department" required><option value="">Select department</option><option>Computer Science</option><option>Software Engineering</option><option>Information Technology</option><option>Data Science</option><option>Cyber Security</option></select></div>
   <div class="field"><label for="status">Status</label><select id="status"><option>Active</option><option>Inactive</option></select></div>
  </div>
  <div class="modalfoot"><button type="button" class="secondary" id="cancelBtn">Cancel</button><button class="primary" type="submit">Save Student</button></div>
 </form>
</div>
<script>
const starter = [
 {id:"BSCS-001",name:"Areeba Khan",email:"areeba@example.com",department:"Computer Science",status:"Active"},
 {id:"BSCS-002",name:"Hamza Ali",email:"hamza@example.com",department:"Software Engineering",status:"Active"},
 {id:"BSCS-003",name:"Sara Ahmed",email:"sara@example.com",department:"Information Technology",status:"Inactive"}
];
let students = JSON.parse(localStorage.getItem("campustrack_students") || "null") || starter;
let editingId = null;
const $ = id => document.getElementById(id);
function save(){localStorage.setItem("campustrack_students",JSON.stringify(students));}
function render(){
 const q=$("search").value.trim().toLowerCase();
 const shown=students.filter(s=>[s.id,s.name,s.email,s.department,s.status].some(v=>v.toLowerCase().includes(q)));
 $("totalCount").textContent=students.length;
 $("activeCount").textContent=students.filter(s=>s.status==="Active").length;
 $("deptCount").textContent=new Set(students.map(s=>s.department)).size;
 $("studentRows").innerHTML=shown.length?shown.map(s=>`<tr><td><strong>${escapeHtml(s.id)}</strong></td><td>${escapeHtml(s.name)}</td><td>${escapeHtml(s.email)}</td><td>${escapeHtml(s.department)}</td><td><span class="pill" style="${s.status==="Inactive"?"background:#f1f2f5;color:#687083":""}">${escapeHtml(s.status)}</span></td><td><div class="actions"><button class="secondary" data-edit="${encodeURIComponent(s.id)}">Edit</button><button class="danger" data-delete="${encodeURIComponent(s.id)}">Delete</button></div></td></tr>`).join(""):`<tr><td colspan="6" class="empty">No students found. Add a student to get started.</td></tr>`;
}
function escapeHtml(v){return String(v).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));}
function openModal(s=null){
 editingId=s?s.id:null;$("modalTitle").textContent=s?"Edit Student":"Add Student";
 $("sid").value=s?s.id:"";$("sid").disabled=!!s;$("name").value=s?s.name:"";$("email").value=s?s.email:"";
 $("department").value=s?s.department:"";$("status").value=s?s.status:"Active";$("modalBack").classList.add("show");$("name").focus();
}
function closeModal(){$("modalBack").classList.remove("show");$("studentForm").reset();$("sid").disabled=false;editingId=null;}
$("addBtn").addEventListener("click",()=>openModal());
$("cancelBtn").addEventListener("click",closeModal);
$("modalBack").addEventListener("click",e=>{if(e.target===$("modalBack"))closeModal();});
$("search").addEventListener("input",render);
$("studentRows").addEventListener("click",e=>{
 const edit=e.target.closest("[data-edit]"),del=e.target.closest("[data-delete]");
 if(edit){const id=decodeURIComponent(edit.dataset.edit);openModal(students.find(s=>s.id===id));}
 if(del){const id=decodeURIComponent(del.dataset.delete);if(confirm("Delete this student record?")){students=students.filter(s=>s.id!==id);save();render();}}
});
$("studentForm").addEventListener("submit",e=>{
 e.preventDefault();
 const record={id:$("sid").value.trim(),name:$("name").value.trim(),email:$("email").value.trim(),department:$("department").value,status:$("status").value};
 if(!editingId&&students.some(s=>s.id.toLowerCase()===record.id.toLowerCase())){alert("This Student ID already exists.");return;}
 if(editingId){students=students.map(s=>s.id===editingId?record:s);}else{students.push(record);}
 save();render();closeModal();
});
$("exportBtn").addEventListener("click",()=>{
 const headers=["Student ID","Name","Email","Department","Status"];
 const rows=students.map(s=>[s.id,s.name,s.email,s.department,s.status]);
 const csv=[headers,...rows].map(r=>r.map(v=>'"'+String(v).replace(/"/g,'""')+'"').join(",")).join("\n");
 const blob=new Blob([csv],{type:"text/csv;charset=utf-8;"}),url=URL.createObjectURL(blob),a=document.createElement("a");
 a.href=url;a.download="campustrack-students.csv";a.click();URL.revokeObjectURL(url);
});
render();
</script>
</body></html>
